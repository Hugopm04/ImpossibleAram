{
 "_doc": "Maps augment/item mechanic tags to champion-profile attributes (0-1) used for champion fit. fit(c, a) = geometric mean over the augment's hooked attributes of (floor + (1 - floor) * attr), times champion-flag boosts. Tags not listed here do not affect fit. Champion attributes are auto-derived in pipeline/build.py (champion profiles) and can be overridden in curation/champions.json.",
 "floor": 0.3,
 "defaultFit": 0.85,
 "hooks": {
  "on:attack": "attack", "on:onhit": "attack", "procsOnHit": "attack", "gives:AS": "attack", "convert:AP>attack": "attack",
  "on:crit": "crit", "gives:crit": "crit", "requires:crit": "crit", "scales:crit": "crit", "convert:crit>AH": "crit",
  "on:abilityHit": "spam", "on:cast": "spam", "abilitiesCrit": "spam", "amp:abilityDamage": "spam", "abilitiesOnHit": "spam", "refund": "spam", "gives:AH": "spam", "spam": "spam",
  "on:ultCast": "ult", "on:ultHit": "ult", "ult:double": "ult", "ult:spam": "ult", "gives:ultAH": "ult",
  "on:dash": "dash", "cdr:dash": "dash",
  "on:immobilize": "cc", "amp:slow": "slow",
  "on:healShield": "healShield", "amp:healShield": "healShield", "healShieldCrit": "healShield", "gives:HSP": "healShield", "on:heal": "selfHeal", "amp:shield": "healShield",
  "ally": "ally", "on:allyDamage": "ally",
  "scales:AP": "ap", "gives:AP": "ap", "convert:AP>AD": "ap", "convert:AP>AH": "ap", "convert:AP>AS": "ap", "amp:AP": "ap",
  "scales:AD": "ad", "scales:bonusAD": "ad", "gives:AD": "ad", "amp:AD": "ad", "convert:AD>AP": "ad", "gives:pen": "damage",
  "scales:HP": "tank", "gives:HP": "tank", "scales:armor": "tank", "scales:MR": "tank", "on:damageTaken": "tank", "item:Heartsteel": "tank",
  "requires:mana": "mana", "scales:mana": "mana", "convert:mana>HP": "mana",
  "on:channel": "channel",
  "burn": "burn", "on:burn": "burn",
  "amp:summons": "summons",
  "on:snipe": "longRange", "longRange": "longRange", "gives:range": "ranged",
  "requires:closeRange": "closeRange",
  "on:stealth": "stealth",
  "on:takedown": "skirmish", "on:burst": "burst", "on:damage": "damage", "execute": "damage",
  "convert:heal>damage": "selfHeal",
  "sealsUlt": "noUlt",
  "amp:spin": "spin",
  "scales:MS": "mobility", "gives:MS": "mobility",
  "convert:AS>AH": "attack"
 },
 "championAttributes": {
  "ap": "share of AP scaling in the kit (ability ratios)",
  "ad": "share of AD scaling in the kit",
  "tank": "share of HP/armor/MR scaling + durability",
  "attack": "reliance on basic attacks / on-hit",
  "crit": "how naturally the champion builds crit",
  "spam": "ability cast frequency (short basic cooldowns, ammo, resets)",
  "ult": "impact of the ultimate",
  "noUlt": "1 - ult (for augments that seal the ultimate)",
  "dash": "number/frequency of dash, blink or teleport abilities",
  "cc": "number of immobilizing abilities",
  "slow": "number of slowing effects",
  "healShield": "heals/shields on self or allies",
  "selfHeal": "self-healing in the kit",
  "ally": "support orientation",
  "mana": "1 if mana user",
  "channel": "has channelled abilities",
  "burn": "has damage-over-time",
  "summons": "has pets/summons/clones",
  "longRange": "long-range abilities (artillery)",
  "ranged": "1 if ranged",
  "closeRange": "1 if melee or close-range aura fighter",
  "stealth": "has stealth/camouflage",
  "skirmish": "takes part in many takedowns (aoe + mobility)",
  "burst": "high burst damage",
  "damage": "general damage output",
  "mobility": "benefits from move speed",
  "spin": "has spinning abilities (Spin To Win list)"
 }
}
